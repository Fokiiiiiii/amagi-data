[{"id":1,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"지휘관 각하, 슬슬 페이스를 올리셔야겠어요.","type":1},{"id":2,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"한 치의 오차도 없군요. 훌륭해요♪","type":2},{"id":3,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"아가씨들의 작은 비밀을 찾아내 버렸답니다.","type":2},{"id":4,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"조금 애를 먹고 계시나요? 조금 더 꼼꼼히 살펴보시는 건 어떠신지?","type":3},{"id":5,"param":[1,2,3],"sculpture":"gezi_2","show_time":2000,"text":"다행이에요. 드디어 찾았답니다♪","type":4},{"id":6,"param":[1,2,3],"sculpture":"gezi_2","show_time":2000,"text":"이것이야말로 제가 기대했던 서프라이즈예요♪","type":4},{"id":7,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"시간…… 얼마 안 남았어…… 「서둘러☆(>o<)」","type":1},{"id":8,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"지휘관 때문에…… 두근두근…… 「>w<」","type":2},{"id":9,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"지휘관…… 대단해……! 「(o°▿°)o」","type":2},{"id":10,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"막혔어? …… 심호흡해…… 「っ ̯ -。 」","type":3},{"id":11,"param":[4,5,6],"sculpture":"u2501_2","show_time":2000,"text":"찾았어…… 고마워…… 「o(//▿//)q」","type":4},{"id":12,"param":[4,5,6],"sculpture":"u2501_2","show_time":2000,"text":"이거…… 정말 소중한 거야…… 「>w<」","type":4},{"id":13,"param":[],"sculpture":"molici_2","show_time":2000,"text":"째깍째깍 째깍째깍――이제 시간 없어. 키히히히♪","type":1},{"id":14,"param":[],"sculpture":"molici_2","show_time":2000,"text":"우와, 수간호사보다 빠른걸!","type":2},{"id":15,"param":[],"sculpture":"molici_2","show_time":2000,"text":"키히히히♪ 정말 손이 빠르네.","type":2},{"id":16,"param":[],"sculpture":"molici_2","show_time":2000,"text":"설마 투명해진 거야? ! 더 잘 찾아봐!","type":3},{"id":17,"param":[7,8,9],"sculpture":"molici_2","show_time":2000,"text":"대단해~! 내가 숨겨둔 걸 찾아내다니♪","type":4},{"id":18,"param":[7,8,9],"sculpture":"molici_2","show_time":2000,"text":"전부 중요한 도구야!","type":4},{"id":19,"param":[],"sculpture":"z15_2","show_time":2000,"text":"나, 너무 조급해서 데일 것만 같아~","type":1},{"id":20,"param":[],"sculpture":"z15_2","show_time":2000,"text":"지휘관한테 포상을 줄까나♪","type":2},{"id":21,"param":[],"sculpture":"z15_2","show_time":2000,"text":"끝나면 말이야, 같이 즐거운 거 하자~","type":2},{"id":22,"param":[],"sculpture":"z15_2","show_time":2000,"text":"조급해하지 말고, 한 번 더 확인해 봐.","type":3},{"id":23,"param":[10,11,12],"sculpture":"z15_2","show_time":2000,"text":"톡톡히 「보답」해 줄게~","type":4},{"id":24,"param":[10,11,12],"sculpture":"z15_2","show_time":2000,"text":"에헤헤, 내 보물을 찾았다!","type":4},{"id":25,"param":[],"sculpture":"z14_2","show_time":2000,"text":"꺅! 시, 시간이 없어요……","type":1},{"id":26,"param":[],"sculpture":"z14_2","show_time":2000,"text":"해냈다! 지휘관님, 대단해요……!","type":2},{"id":27,"param":[],"sculpture":"z14_2","show_time":2000,"text":"지휘관님, 허무할 정도로 쉽게 끝내버리다니……!","type":2},{"id":28,"param":[],"sculpture":"z14_2","show_time":2000,"text":"으우…… 지휘관님한테 도움이 되고 싶은데……","type":3},{"id":29,"param":[13,14,15],"sculpture":"z14_2","show_time":2000,"text":"지휘관님은 저보다 기억력이 좋네요~","type":4},{"id":30,"param":[13,14,15],"sculpture":"z14_2","show_time":2000,"text":"소중한 걸 찾았어요! 너무 기뻐요……","type":4},{"id":31,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"시간…… 하아아…… 땀이 나기 시작했어……♥","type":1},{"id":32,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"지휘관은 몸놀림이 참 민첩하네~","type":2},{"id":33,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"지휘관한테…… 좋은 냄새가 나……♥","type":2},{"id":34,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"으음…… 목표가 바로 저기에 있는 것 같은……?","type":3},{"id":35,"param":[16,17,18],"sculpture":"mojiaduoer_4","show_time":2000,"text":"코가 참 예민하네~","type":4},{"id":36,"param":[16,17,18],"sculpture":"mojiaduoer_4","show_time":2000,"text":"역시 찾았다! 지휘과아안, 최고야아♥","type":4},{"id":37,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"시간이 없습니다. 지휘관님, 서둘러 결단을 내리시길.","type":1},{"id":38,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"과연 지휘관님…… 혜안이십니다.","type":2},{"id":39,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"안정감마저 느껴지는 결단력이군요. 후후후.","type":2},{"id":40,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"조급해하지 말고 천천히 가요. 아마기도 함께 생각할 테니까요.","type":3},{"id":41,"param":[19,20,21],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"깊숙이 숨겨져 있어도, 지휘관님의 눈은 피할 수 없나 보군요.","type":4},{"id":42,"param":[19,20,21],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"아마기에 대해 그토록 잘 알아주시다니…… 너무 기뻐요.","type":4}]
