[{"id":1,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"閣下，我們該加快節奏了。","type":1},{"id":2,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"精準無誤！做得漂亮~","type":2},{"id":3,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"發現了淑女們的小秘密呢~","type":2},{"id":4,"param":[],"sculpture":"gezi_2","show_time":2000,"text":"有些棘手嗎？再仔細看看呢。","type":3},{"id":5,"param":[1,2,3],"sculpture":"gezi_2","show_time":2000,"text":"太好了，終於找到這個了~","type":4},{"id":6,"param":[1,2,3],"sculpture":"gezi_2","show_time":2000,"text":"這正是我期待的驚喜呢！","type":4},{"id":7,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"時間……不多了……「急☆(>o<)」","type":1},{"id":8,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"指揮官，讓我心跳加速……「>w<」","type":2},{"id":9,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"指揮官……好厲害！「(o°▿°)o」","type":2},{"id":10,"param":[],"sculpture":"u2501_2","show_time":2000,"text":"卡住了？……深呼吸……「っ ̯ -。」","type":3},{"id":11,"param":[4,5,6],"sculpture":"u2501_2","show_time":2000,"text":"找到了……謝謝~「o(//▿//)q」","type":4},{"id":12,"param":[4,5,6],"sculpture":"u2501_2","show_time":2000,"text":"這是……很珍貴的東西……「>w<」","type":4},{"id":13,"param":[],"sculpture":"molici_2","show_time":2000,"text":"滴答滴答——沒時間了，嘻嘻嘻~","type":1},{"id":14,"param":[],"sculpture":"molici_2","show_time":2000,"text":"哇，比護士長的動作還快！","type":2},{"id":15,"param":[],"sculpture":"molici_2","show_time":2000,"text":"嘻嘻嘻，真是乾脆俐落~","type":2},{"id":16,"param":[],"sculpture":"molici_2","show_time":2000,"text":"難道是隱形了？！再找找看！","type":3},{"id":17,"param":[7,8,9],"sculpture":"molici_2","show_time":2000,"text":"厲害！找到我藏的彩蛋了~","type":4},{"id":18,"param":[7,8,9],"sculpture":"molici_2","show_time":2000,"text":"這些都是重要道具喔！","type":4},{"id":19,"param":[],"sculpture":"z15_2","show_time":2000,"text":"人家要急得過熱啦~","type":1},{"id":20,"param":[],"sculpture":"z15_2","show_time":2000,"text":"我是不是該給你點獎勵呢~","type":2},{"id":21,"param":[],"sculpture":"z15_2","show_time":2000,"text":"解決完就去做點快樂的事吧~","type":2},{"id":22,"param":[],"sculpture":"z15_2","show_time":2000,"text":"別急，我們再檢查一下？","type":3},{"id":23,"param":[10,11,12],"sculpture":"z15_2","show_time":2000,"text":"讓我來好好「答謝」你吧~","type":4},{"id":24,"param":[10,11,12],"sculpture":"z15_2","show_time":2000,"text":"嘿嘿，我的寶貝找到了！","type":4},{"id":25,"param":[],"sculpture":"z14_2","show_time":2000,"text":"咿！時、時間不多了……","type":1},{"id":26,"param":[],"sculpture":"z14_2","show_time":2000,"text":"做到了！指揮官好厲害！","type":2},{"id":27,"param":[],"sculpture":"z14_2","show_time":2000,"text":"指揮官，完成得很輕鬆呢……！","type":2},{"id":28,"param":[],"sculpture":"z14_2","show_time":2000,"text":"嗚……好想幫上指揮官的忙……","type":3},{"id":29,"param":[13,14,15],"sculpture":"z14_2","show_time":2000,"text":"指揮官的記憶力比我還好呢~","type":4},{"id":30,"param":[13,14,15],"sculpture":"z14_2","show_time":2000,"text":"找到了很重要的東西！好開心……","type":4},{"id":31,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"時間……哈啊，有些出汗了♡","type":1},{"id":32,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"動作真是俐落呢~","type":2},{"id":33,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"指揮官散發出了好聞的氣味♡","type":2},{"id":34,"param":[],"sculpture":"mojiaduoer_4","show_time":2000,"text":"啊……感覺目標就在附近？","type":3},{"id":35,"param":[16,17,18],"sculpture":"mojiaduoer_4","show_time":2000,"text":"嗅覺真是靈敏呢~","type":4},{"id":36,"param":[16,17,18],"sculpture":"mojiaduoer_4","show_time":2000,"text":"果然找到了，指揮官好棒♡","type":4},{"id":37,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"時間不多，主上請速速決斷。","type":1},{"id":38,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"主上果然明察秋毫。","type":2},{"id":39,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"令人安心的判斷力呢~","type":2},{"id":40,"param":[],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"主上勿躁，容我一同推演。","type":3},{"id":41,"param":[19,20,21],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"藏得再深，也瞞不過您。","type":4},{"id":42,"param":[19,20,21],"sculpture":"tiancheng_cv_3","show_time":2000,"text":"主上如此懂我，甚好。","type":4}]
